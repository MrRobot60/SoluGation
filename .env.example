# Copier en .env (jamais commité) et remplacer toutes les valeurs.

# Django
DJANGO_SECRET_KEY=a-remplacer-par-une-longue-valeur-aleatoire
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_DB=solugation
POSTGRES_USER=solugation
POSTGRES_PASSWORD=a-remplacer
DATABASE_URL=postgres://solugation:a-remplacer@postgres:5432/solugation

# Stockage S3 : SeaweedFS (dev, service « stockage ») / Scaleway Object Storage (prod)
S3_ENDPOINT_URL=http://stockage:8333
S3_ACCESS_KEY=solugation
S3_SECRET_KEY=a-remplacer-8-caracteres-min
S3_BUCKET=solugation
S3_REGION=fr-par
S3_USE_SSL=False
# Chiffrement serveur (AES256 en prod ; vide en dev)
S3_SSE=

UPLOAD_MAX_MO=50

# Mails (en dev, Docker Compose pointe vers Mailpit). En prod : relais SMTP avec TLS.
FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=SoluGation <notifications@solugation.local>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# IA. factice = hors ligne (aucun envoi) ; mistral = API Mistral (UE).
# MISTRAL_ZDR_CONFIRME=True uniquement après activation du Zero Data Retention et refus de l'entraînement
# dans la console Mistral (Admin > Privacy) : sinon les documents seraient conservés 30 jours chez le fournisseur.
IA_FOURNISSEUR=factice
MISTRAL_API_KEY=
MISTRAL_MODELE=mistral-medium-latest
MISTRAL_ZDR_CONFIRME=False
