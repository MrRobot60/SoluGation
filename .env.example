# Copier en .env (jamais commité) et remplacer toutes les valeurs.

# Django
DJANGO_SECRET_KEY=a-remplacer-par-une-longue-valeur-aleatoire
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# PostgreSQL
POSTGRES_DB=solugation
POSTGRES_USER=solugation
POSTGRES_PASSWORD=a-remplacer
DATABASE_URL=postgres://solugation:a-remplacer@postgres:5432/solugation

# Stockage S3 : SeaweedFS (dev, service « stockage ») / Scaleway Object Storage (prod)
S3_ENDPOINT_URL=http://stockage:8333
S3_ACCESS_KEY=solugation
S3_SECRET_KEY=a-remplacer-8-caracteres-min
S3_BUCKET=solugation
S3_REGION=fr-par
S3_USE_SSL=False
# Chiffrement serveur (AES256 en prod ; vide en dev)
S3_SSE=

UPLOAD_MAX_MO=50

# Données de démonstration (manage.py creer_demo, développement uniquement)
DEV_ADMIN_EMAIL=admin@solugation.test
DEV_ADMIN_PASSWORD=a-remplacer-12-caracteres-min

# Mails (en dev, Docker Compose pointe vers Mailpit). En prod : relais SMTP avec TLS.
FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=SoluGation <notifications@solugation.local>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# IA (facultative). Sans configuration, SoluGation fonctionne entièrement sans IA.
# Le plus simple : configurer le fournisseur depuis l'écran Administration (il prime sur ce fichier).
# Par fichier : IA_FOURNISSEUR=aucun (défaut) | compatible (toute API compatible OpenAI) | scaleway | mistral (raccourcis)
# | factice (développement et tests, hors ligne). Le choix du fournisseur et de ses conditions (conservation,
# entraînement) relève de l'administrateur : IA_ZDR_CONFIRME=True vaut acceptation de cette responsabilité.
IA_FOURNISSEUR=aucun
IA_NOM=
IA_URL=
IA_MODELE=
IA_CLE=
IA_ZDR_CONFIRME=False
# Clé de chiffrement de la clé d'API saisie à l'écran (Fernet). Vide : dérivée de DJANGO_SECRET_KEY.
IA_CLE_CHIFFREMENT=
# Autoriser une IA sur le réseau local (ex. Ollama : http://ollama:11434/v1). Désactivé par défaut (protection SSRF).
IA_AUTORISER_RESEAU_LOCAL=False
MISTRAL_API_KEY=
MISTRAL_MODELE=mistral-small-latest
MISTRAL_ZDR_CONFIRME=False
