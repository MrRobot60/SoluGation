# Proxy de production SoluGation : interface compilée, et /api, /admin, /static transmis au serveur Django.
# Le mode HTTPS se choisit par SOLUGATION_TLS (fichiers deploiement/sites/) :
#   auto        certificat Let's Encrypt obtenu et renouvelé automatiquement (serveur joignable depuis Internet) ;
#   certificat  certificat de votre organisation (deploiement/certificats/solugation.crt et .key) ;
#   interne     autorité de certification propre à Caddy (laboratoire, réseau fermé, essai local) ;
#   externe     HTTPS assuré en amont (répartiteur de charge, pare-feu applicatif, tunnel Cloudflare) : Caddy en HTTP.
{
	admin off
	servers {
		# Proxys amont dont on accepte X-Forwarded-For / X-Forwarded-Proto (mode externe) ; personne par défaut.
		trusted_proxies static {$SOLUGATION_PROXYS_AMONT:127.0.0.1/32}
	}
}

(solugation) {
	encode zstd gzip

	# Taille maximale d'un envoi : celle de l'application (UPLOAD_MAX_MO) + marge pour l'enveloppe multipart.
	request_body {
		max_size {$SOLUGATION_ENVOI_MAX_MO:60}MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}

	@django path /api/* /admin /admin/* /static/*
	handle @django {
		# X-Forwarded-For : adresse réelle du client (journal d'audit), complétée par Caddy.
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		header X-Frame-Options "DENY"
		@immuables path /assets/*
		header @immuables Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}

import sites/{$SOLUGATION_TLS:auto}.caddy
