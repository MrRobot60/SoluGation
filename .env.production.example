# SoluGation : configuration de production. Copier en .env.production (jamais commité), remplacer chaque
# « a-remplacer », puis : docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# Le serveur refuse de démarrer tant qu'une valeur d'exemple subsiste. Détails : docs/15-production.md

# Nom de domaine public (un enregistrement DNS A/AAAA doit pointer vers ce serveur ; ports 80 et 443 ouverts).
# Certificat HTTPS obtenu et renouvelé automatiquement (Let's Encrypt).
SOLUGATION_DOMAINE=solugation.exemple.fr

# Secrets : python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=a-remplacer
POSTGRES_PASSWORD=a-remplacer
POSTGRES_DB=solugation
POSTGRES_USER=solugation

# Stockage des fichiers. Par défaut, stockage S3 intégré (profil « stockage-local »).
# S3 externe : COMPOSE_PROFILES= (vide), S3_ENDPOINT_URL=https://s3.fr-par.scw.cloud, clés de l'hébergeur,
# S3_USE_SSL=True et S3_SSE=AES256 (chiffrement au repos).
COMPOSE_PROFILES=stockage-local
S3_ENDPOINT_URL=http://stockage:8333
S3_ACCESS_KEY=solugation
S3_SECRET_KEY=a-remplacer
S3_BUCKET=solugation
S3_REGION=fr-par
S3_USE_SSL=False
S3_SSE=

# Taille maximale d'un document (Mo) ; le proxy accepte un peu plus pour l'enveloppe de l'envoi.
UPLOAD_MAX_MO=50
SOLUGATION_ENVOI_MAX_MO=60

# Mails : relais SMTP de votre organisation ou d'un prestataire (TLS).
DEFAULT_FROM_EMAIL=SoluGation <notifications@exemple.fr>
EMAIL_HOST=smtp.exemple.fr
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Lien « Code source » affiché aux utilisateurs (vide : dépôt officiel https://github.com/MrRobot60/SoluGation). Si vous modifiez SoluGation et le
# proposez en ligne, l'AGPL-3.0 (art. 13) impose d'y indiquer le code source de VOTRE version.
SOLUGATION_URL_CODE_SOURCE=

# Serveur web : processus gunicorn (2 × cœurs + 1 est un bon départ).
GUNICORN_WORKERS=3

# Double authentification (application TOTP) : desactivee | facultative (défaut) | administrateurs | tous.
# L'écran Administration (administrateur de l'installation) prime sur cette valeur.
DOUBLE_AUTH_POLITIQUE=facultative
# Clé de chiffrement des secrets de double authentification (Fernet). Vide : dérivée de DJANGO_SECRET_KEY.
SOLUGATION_CLE_CHIFFREMENT=

# IA facultative : le plus simple est de la configurer depuis l'écran Administration. Voir docs/07-ia.md.
IA_FOURNISSEUR=aucun
IA_CLE_CHIFFREMENT=
IA_AUTORISER_RESEAU_LOCAL=False

# HTTPS : auto (Let's Encrypt) | certificat (deploiement/certificats/) | interne (autorité Caddy) | externe (proxy amont).
# Voir docs/15-production.md, « Modes HTTPS ». En mode externe : SOLUGATION_PROXYS_AMONT et SOLUGATION_NB_PROXYS=2.
SOLUGATION_TLS=auto
SOLUGATION_PROXYS_AMONT=
SOLUGATION_NB_PROXYS=1

# Adresse d'écoute et ports publiés (à changer seulement pour un essai local ou un proxy amont).
SOLUGATION_ECOUTE=0.0.0.0
SOLUGATION_PORT_HTTP=80
SOLUGATION_PORT_HTTPS=443
